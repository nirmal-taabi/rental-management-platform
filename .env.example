# ─── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─── Backend ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ─── Database — choose ONE of the two options below ──────────

# Option A: Supabase / production — paste your connection string here.
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
# Add ?sslmode=require at the end for Supabase.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option B: Local PostgreSQL (default for development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rental_management
DB_USER=rental_user
DB_PASSWORD=change_me

# SSL (set to true when connecting to Supabase or any hosted PG)
DB_SSL=false
# Set to false only if your PG host uses a self-signed certificate
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
