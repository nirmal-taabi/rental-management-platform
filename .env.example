# ─── Frontend ────────────────────────────────────────────────
# For local development:
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# For production, set this to your backend API URL on Vercel/deployment platform
# Example: VITE_API_BASE_URL=https://your-api.vercel.app/api/v1

# ─── Backend ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ─── Password recovery email (SMTP) ──────────────────────────
# Configure a real SMTP provider before enabling password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Database — choose ONE of the two options below ──────────

# Option A: Supabase / production — use the Session Pooler URI for IPv4 hosts such as Render.
# Get it from: Supabase Dashboard → Connect → Session Pooler.
# URL-encode reserved characters in the username/password (e.g. # as %23).
# Omit the square brackets around Supabase's [YOUR-PASSWORD] placeholder.
# Copy the exact pooler URI; its host and username are project/region-specific.
# DATABASE_URL=postgresql://postgres.PROJECT-REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Set DB_SSL=true when using Supabase.

# Option B: Local PostgreSQL (default for development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rental_management
DB_USER=rental_user
DB_PASSWORD=change_me

# SSL (set to true when connecting to Supabase or any hosted PG)
DB_SSL=false
# Set to false only if your PG host uses a self-signed certificate
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
